    <joint name="front_left_combined_joint" type="universal">
      <parent>chassis</parent><child>front_left_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.55</lower><upper>0.55</upper></limit>
        <dynamics><damping>0.5</damping><friction>0.02</friction></dynamics></axis>
      <axis2><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.01</damping><friction>0.0</friction></dynamics></axis2>
    </joint>
    <joint name="front_right_combined_joint" type="universal">
