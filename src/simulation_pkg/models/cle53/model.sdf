      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.5</mass>
        <inertia><ixx>0.001283</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.002256</iyy><iyz>0</iyz><izz>0.001283</izz></inertia>
