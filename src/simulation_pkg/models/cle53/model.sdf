    <link name="camera_link">
      <pose>0.24 0 0.595 0 0.26529 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.05</mass>
        <inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia>
      </inertial>
      <visual name="camera_visual"><geometry><box><size>0.03 0.09 0.03</size></box></geometry></visual>
      <sensor name="camera" type="camera">
        <always_on>1</always_on><visualize>0</visualize><update_rate>30</update_rate>
        <camera name="camera_cam">
          <horizontal_fov>1.2292</horizontal_fov>
          <image><width>1024</width><height>576</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>50</far></clip>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.007</stddev></noise>
        </camera>
        <plugin name="camera_driver" filename="libgazebo_ros_camera.so">
          <camera_name>camera</camera_name>
          <frame_name>camera_optical</frame_name>
        </plugin>
      </sensor>
    </link>
    <joint name="camera_link_joint" type="fixed"><parent>chassis</parent><child>camera_link</child></joint>
    <link name="rear_camera_link">
      <pose>-0.225 0 0.275 0 0.19199 3.14159</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.05</mass>
        <inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia>
      </inertial>
      <visual name="rear_camera_visual"><geometry><box><size>0.03 0.09 0.03</size></box></geometry></visual>
      <sensor name="rear_camera" type="camera">
        <always_on>1</always_on><visualize>0</visualize><update_rate>30</update_rate>
        <camera name="rear_camera_cam">
          <horizontal_fov>1.2292</horizontal_fov>
          <image><width>1024</width><height>576</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>50</far></clip>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.007</stddev></noise>
        </camera>
        <plugin name="rear_camera_driver" filename="libgazebo_ros_camera.so">
          <camera_name>rear_camera</camera_name>
          <frame_name>rear_camera_optical</frame_name>
        </plugin>
      </sensor>
    </link>
    <joint name="rear_camera_link_joint" type="fixed"><parent>chassis</parent><child>rear_camera_link</child></joint>
    <link name="lidar_link">
      <pose>0.65 0 0.305 0 0.19199 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.17</mass>
        <inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia>
      </inertial>
      <visual name="lidar_visual"><geometry><cylinder><radius>0.035</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
      <sensor name="lidar" type="ray">
        <always_on>1</always_on><visualize>1</visualize><update_rate>5.5</update_rate>
        <ray>
          <scan><horizontal><samples>360</samples><resolution>1</resolution>
            <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.15</min><max>12.0</max><resolution>0.005</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
        </ray>
        <plugin name="scan" filename="libgazebo_ros_ray_sensor.so">
          <ros><remapping>~/out:=scan</remapping></ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>lidar_link</frame_name>
        </plugin>
      </sensor>
    </link>
    <joint name="lidar_link_joint" type="fixed"><parent>chassis</parent><child>lidar_link</child></joint>
    <link name="us_front_center_link">
      <pose>0.817 0 0.149 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.01</mass>
        <inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia>
      </inertial>
      <visual name="us_front_center_visual"><geometry><box><size>0.015 0.045 0.02</size></box></geometry></visual>
      <sensor name="us_front_center" type="ray">
        <always_on>1</always_on><visualize>0</visualize><update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal><samples>5</samples><resolution>1</resolution><min_angle>-0.1309</min_angle><max_angle>0.1309</max_angle></horizontal>
            <vertical><samples>5</samples><resolution>1</resolution><min_angle>-0.1309</min_angle><max_angle>0.1309</max_angle></vertical>
          </scan>
          <range><min>0.02</min><max>4</max><resolution>0.005</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.005</stddev></noise>
        </ray>
        <plugin name="us_front_center_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros><namespace>ultrasonic</namespace><remapping>~/out:=front_center</remapping></ros>
          <output_type>sensor_msgs/Range</output_type>
          <radiation_type>ultrasound</radiation_type>
          <frame_name>us_front_center_link</frame_name>
        </plugin>
      </sensor>
    </link>
    <joint name="us_front_center_link_joint" type="fixed"><parent>chassis</parent><child>us_front_center_link</child></joint>
    <link name="us_left_link">
      <pose>0.39 0.243 0.135 0 0 1.5708</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.01</mass>
        <inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia>
      </inertial>
