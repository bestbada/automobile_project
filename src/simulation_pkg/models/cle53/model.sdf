<?xml version="1.0"?>
<!-- 자동 생성: gen_cle53_sdf.py 로 cle53_vehicle.yaml에서 생성. 직접 수정하지 말고 yaml/스크립트를 고칠 것 -->
<sdf version="1.6">
  <model name="cle53">
    <static>false</static>
    
    <link name="chassis">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.3 0 0.25 0 0 0</pose>
        <mass>27.62</mass>
        <inertia><ixx>0.768987</ixx><ixy>0</ixy><ixz>0</ixz><iyy>2.449434</iyy><iyz>0</iyz><izz>2.83128</izz></inertia>
      </inertial>
      <collision name="body_rear_collision"><pose>0.135 0 0.205 0 0 0</pose><geometry><box><size>0.63 0.5 0.29</size></box></geometry></collision>
      <collision name="body_hood_collision"><pose>0.6 0 0.115 0 0 0</pose><geometry><box><size>0.3 0.5 0.11</size></box></geometry></collision>
      <collision name="body_nose_collision"><pose>0.75 0 0.115 1.5708 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.5</length></cylinder></geometry></collision>
      <visual name="windshield_glass"><pose>0.335 0 0.34967 0 0.74542 0</pose><geometry><box><size>0.17692 0.4 0.004</size></box></geometry><material><ambient>0.15 0.2 0.25 1</ambient><diffuse>0.2 0.25 0.3 1</diffuse><specular>0.8 0.8 0.8 1</specular></material><transparency>0.65</transparency></visual>
