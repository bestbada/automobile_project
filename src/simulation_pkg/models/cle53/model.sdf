      <visual name="headrest_l"><pose>0.06 0.11 0.36 0 0 0</pose><geometry><box><size>0.025 0.09 0.04</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
      <visual name="seat_back_r"><pose>0.07 -0.11 0.315 0 -0.25 0</pose><geometry><box><size>0.03 0.14 0.06</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
      <visual name="headrest_r"><pose>0.06 -0.11 0.36 0 0 0</pose><geometry><box><size>0.025 0.09 0.04</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
      <visual name="grille"><pose>0.806 0 0.125 0 0 0</pose><geometry><box><size>0.008 0.2 0.055</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
      <visual name="lower_intake"><pose>0.8 0 0.088 0 0 0</pose><geometry><box><size>0.01 0.3 0.018</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
      <visual name="headlamp_l"><pose>0.788 0.165 0.168 0 0 0.35</pose><geometry><box><size>0.025 0.075 0.012</size></box></geometry><material><ambient>0.9 0.9 0.95 1</ambient><diffuse>0.9 0.9 0.95 1</diffuse><emissive>0.6 0.6 0.65 1</emissive></material></visual>
      <visual name="taillamp_l"><pose>-0.176 0.12 0.228 0 0 0</pose><geometry><box><size>0.008 0.14 0.012</size></box></geometry><material><ambient>0.6 0.02 0.02 1</ambient><diffuse>0.8 0.05 0.05 1</diffuse><emissive>0.5 0.0 0.0 1</emissive></material></visual>
      <visual name="mirror_l"><pose>0.37 0.27 0.315 0 0 0</pose><geometry><box><size>0.03 0.045 0.025</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
      <visual name="headlamp_r"><pose>0.788 -0.165 0.168 0 0 -0.35</pose><geometry><box><size>0.025 0.075 0.012</size></box></geometry><material><ambient>0.9 0.9 0.95 1</ambient><diffuse>0.9 0.9 0.95 1</diffuse><emissive>0.6 0.6 0.65 1</emissive></material></visual>
      <visual name="taillamp_r"><pose>-0.176 -0.12 0.228 0 0 0</pose><geometry><box><size>0.008 0.14 0.012</size></box></geometry><material><ambient>0.6 0.02 0.02 1</ambient><diffuse>0.8 0.05 0.05 1</diffuse><emissive>0.5 0.0 0.0 1</emissive></material></visual>
      <visual name="mirror_r"><pose>0.37 -0.27 0.315 0 0 0</pose><geometry><box><size>0.03 0.045 0.025</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
      <visual name="rear_diffuser"><pose>-0.176 0 0.105 0 0 0</pose><geometry><box><size>0.01 0.3 0.025</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
      <visual name="trunk_spoiler"><pose>-0.165 0 0.2635 0 0 0</pose><geometry><box><size>0.02 0.36 0.008</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><specular>0.4 0.4 0.4 1</specular></material></visual>
      <visual name="lidar_mount"><pose>0.65 0 0.27 0 0 0</pose><geometry><box><size>0.05 0.05 0.03</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
      <visual name="body_mesh"><pose>0 0 0 0 0 0</pose><geometry><mesh><uri>model://cle53/cle53_body.stl</uri></mesh></geometry><material><ambient>0.55 0.56 0.58 1</ambient><diffuse>0.72 0.73 0.75 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
      <visual name="camera_mast">
        <pose>0.21 0 0.44 0 0 0</pose>
        <geometry><box><size>0.03 0.03 0.31</size></box></geometry>
        <material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material>
      </visual>
      <sensor name="chassis_contact" type="contact">
        <contact><collision>body_rear_collision</collision><collision>body_hood_collision</collision><collision>body_nose_collision</collision></contact>
        <update_rate>30</update_rate>
        <plugin name="chassis_contact_plugin" filename="libgazebo_ros_bumper.so">
          <ros><remapping>bumper_states:=chassis_contact</remapping></ros>
          <frame_name>chassis</frame_name>
        </plugin>
      </sensor>
    </link>
    <link name="steering_wheel">
      <pose>0.3 0 0.37 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.05</mass>
        <inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia>
      </inertial>
    </link>
    <joint name="steering_joint" type="revolute">
      <parent>chassis</parent><child>steering_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-7.85</lower><upper>7.85</upper></limit>
        <dynamics><damping>0.1</damping></dynamics></axis>
    </joint>
    <link name="front_left_wheel">
      <pose>0.59 0.22 0.095 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.5</mass>
        <inertia><ixx>0.001283</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.002256</iyy><iyz>0</iyz><izz>0.001283</izz></inertia>
      </inertial>
      <!-- 충돌: 실제로 바닥에 닿는 폭(0.005m)만큼 얇은 원통. 겉모습은 아래 visual -->
      <collision name="front_left_wheel_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.095</radius><length>0.005</length></cylinder></geometry>
        <surface><friction><ode><mu>0.14</mu><mu2>0.8</mu2><fdir1>0 0 1</fdir1><slip1>0</slip1><slip2>0</slip2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>100</kd><min_depth>0.001</min_depth><max_vel>0.1</max_vel></ode></contact></surface>
      </collision>
      <visual name="front_left_wheel_visual">
