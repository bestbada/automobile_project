      <visual name="windshield_header"><pose>0.27 0 0.40967 0 0 0</pose><geometry><box><size>0.02 0.45 0.014</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
      <visual name="cockpit_floor"><pose>0.18 0 0.287 0 0 0</pose><geometry><box><size>0.34 0.42 0.004</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
