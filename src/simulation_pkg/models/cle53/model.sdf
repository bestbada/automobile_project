        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.095</radius><length>0.005</length></cylinder></geometry>
        <surface><friction><ode><mu>0.14</mu><mu2>0.8</mu2><fdir1>0 0 1</fdir1><slip1>0</slip1><slip2>0</slip2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>100</kd><min_depth>0.001</min_depth><max_vel>0.1</max_vel></ode></contact></surface>
      </collision>
      <visual name="front_right_wheel_visual">
