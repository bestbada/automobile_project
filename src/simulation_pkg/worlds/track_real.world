<sdf version="1.6">
  <world name="default">

  <gui fullscreen='0'>
    <plugin name='keyboard' filename='libKeyboardGUIPlugin.so'/>
      <camera name='user_camera'>
        <pose>0 0 20.0 3.14159 1.57079 3.14159</pose> <!-- 초기 시점 -->
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
  </gui>

  <!-- EXPOSURE_K 0.35: 조명(ambient·light·햇빛조각 emissive)을 실제의 0.35배로 렌더링해 포화 방지.
       camera_sim_node(자동노출 흉내)가 이득을 올려 camera/image_raw로 발행. 하늘·신호등 램프는 그대로 -->
  <scene>
    <ambient>0.175 0.175 0.175 1</ambient>
    <background>0.85 0.8 0.75 1</background>
    <shadows>1</shadows>
  </scene>

  
    
    <include><uri>model://lobby_floor</uri><name>lobby_floor</name><pose>0 0 0 0 0 0</pose></include>
